    "narrative": {
      "tokens": [
        {
          "text": "A Portland Police cruiser eases up to the curb and stays there. The window comes down. ",
          "style": "normal",
          "color": null,
          "speed": "normal",
          "pauseAfter": 0,
          "effect": "none"
        },
        {
          "text": "\"You doing alright tonight?\"",
          "style": "normal",
          "color": null,
          "speed": "slow",
          "pauseAfter": 400,
          "effect": "none"
        },
        {
          "text": " It is not a question about your wellbeing.",
          "style": "normal",
          "color": null,
          "speed": "normal",
          "pauseAfter": 0,
          "effect": "none"
        }
      ]
    },
    "choices": [
      {
        "label": "Be polite. Be boring.",
        "check": {
          "stat": "charm",
          "dc": 13
        },
        "outcome": {
          "narrative": {
            "tokens": [
              {
                "text": "You say yes sir, just walking home. You say it like a person with a home. The cruiser idles for a long moment, then pulls away. You breathe out.",
                "style": "normal",
                "color": null,
                "speed": "normal",
                "pauseAfter": 0,
                "effect": "none"
              }
            ]
          },
          "statusChanges": {
            "mood": 4
          },
          "statChanges": null,
