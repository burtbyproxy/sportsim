    "success": {
      "narrative": {
        "tokens": [
          {
            "text": "Tina leans on the bar and gives you her full attention, which is like standing in sunlight — warm, unfocused, and gone the second someone else walks in. ",
            "style": "normal",
            "color": null,
            "speed": "normal",
            "pauseAfter": 200,
            "effect": "none"
          },
          {
            "text": "'Oh my god, totally,' she says to something you didn't finish saying. ",
            "style": "normal",
            "color": null,
            "speed": "normal",
            "pauseAfter": 200,
            "effect": "none"
          },
          {
            "text": "You feel seen. Whether or not you were actually seen is a different question.",
            "style": "normal",
            "color": null,
            "speed": "slow",
            "pauseAfter": 0,
            "effect": "none"
          }
