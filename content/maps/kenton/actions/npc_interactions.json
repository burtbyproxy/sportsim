            "color": null,
            "speed": "normal",
            "pauseAfter": 500,
            "effect": "none"
          },
          {
            "text": "'You eat today?' he asks. ",
            "style": "normal",
            "color": null,
            "speed": "normal",
            "pauseAfter": 300,
            "effect": "none"
          },
          {
            "text": "It's not small talk. He already knows the answer.",
            "style": "normal",
            "color": null,
