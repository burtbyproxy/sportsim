        "tokens": [
          {
            "text": "Maurice is going somewhere. You go too. He doesn't ask if you're coming — he just keeps talking, and you keep walking, and the night moves around you both. ",
            "style": "normal",
            "color": null,
            "speed": "normal",
            "pauseAfter": 300,
            "effect": "none"
          },
          {
            "text": "You end up somewhere you didn't expect. ",
            "style": "normal",
            "color": null,
            "speed": "normal",
            "pauseAfter": 200,
            "effect": "none"
          },
          {
            "text": "You always end up somewhere you didn't expect with Maurice.",
            "style": "italic",
            "color": null,
            "speed": "slow",
            "pauseAfter": 0,
            "effect": "none"
