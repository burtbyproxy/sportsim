{
  "name": "sportsim",
  "version": "0.15.0",
  "description": "Take the Portland art world by storm in the early turn of the Millennium.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint src --ext .js,.vue",
    "format": "prettier --write \"src/**/*.{js,vue,scss}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,scss}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.scss": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "comlink": "^4.4.1",
    "pinia": "^2.1.7",
    "uuid": "^13.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/test-utils": "^2.4.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.22.0",
    "husky": "^9.1.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.2.5",
    "sass": "^1.71.1",
    "vite": "^5.1.4",
    "vitest": "^1.6.1"
  }
}
