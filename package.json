{
  "name": "sportsim",
  "version": "0.17.0",
  "description": "Take the Portland art world by storm in the early turn of the Millennium.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src tests",
    "format": "prettier --write \"{src,tests}/**/*.{js,vue,scss}\" \"content/**/*.json\" \"*.{js,cjs,json,md}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{js,vue,scss}\" \"content/**/*.json\" \"*.{js,cjs,json,md}\" \".github/**/*.yml\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "{src,tests}/**/*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.scss": [
      "prettier --write"
    ],
    "content/**/*.json": [
      "prettier --write"
    ],
    "*.{js,cjs,json,md}": [
      "prettier --write"
    ],
    ".github/**/*.yml": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "comlink": "^4.4.1",
    "pinia": "^2.1.7",
    "uuid": "^13.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/test-utils": "^2.4.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^24.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.2.5",
    "sass": "^1.71.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.1.4",
    "vitest": "^1.6.1"
  }
}
